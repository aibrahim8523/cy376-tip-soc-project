# misp-docker/.env  (SANITISED TEMPLATE — values redacted for sharing)
#
# Copy to .env on the MISP VM and fill in the actual secrets before
# running `sudo docker compose up -d`.

# Platform endpoint
MISP_BASEURL=https://192.168.100.10
MISP_HOSTNAME=misp.lab.local

# Administrator account (CHANGE IMMEDIATELY after first login)
ADMIN_EMAIL=admin@admin.test
ADMIN_PASSWORD=<set-a-strong-password>

# MariaDB
MYSQL_HOST=db
MYSQL_DATABASE=misp
MYSQL_USER=misp
MYSQL_PASSWORD=<set-a-strong-db-password>
MYSQL_ROOT_PASSWORD=<set-a-strong-root-password>

# Misc
TZ=UTC
